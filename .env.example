# Copy to .env and fill in. Never commit .env.

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs per tier. Confirm against `python -m scripts.list_models`.
NEBIUS_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# USD per 1M tokens, used for the cost estimate in the trace.
NEBIUS_PRICE_NANO_INPUT=0.06
NEBIUS_PRICE_NANO_OUTPUT=0.24
NEBIUS_PRICE_SUPER_INPUT=0.30
NEBIUS_PRICE_SUPER_OUTPUT=0.90
NEBIUS_PRICE_ULTRA_INPUT=1.00
NEBIUS_PRICE_ULTRA_OUTPUT=3.00

# live = call Token Factory. mock = rule-based stand-in, no network and no cost (for development without a key).
LLM_MODE=live
# Cache live responses by request hash so re-runs do not re-spend.
LLM_CACHE_ENABLED=true
# Live calls stop for the day (UTC) once spend reaches this. Cached responses still serve.
DAILY_SPEND_CAP_USD=1.00

# Credit discipline: force every task onto one tier (nano|super|ultra). Empty = use the routing table.
LLM_FORCE_TIER=
# Per-task overrides as JSON, e.g. {"planning": "super"}
LLM_TASK_TIER_OVERRIDES={}

# --- Tavily ---
TAVILY_API_KEY=

# --- App ---
# Empty = SQLite file at backend/exportagent.db. Postgres: postgresql+psycopg://user:pass@host:5432/exportagent
DATABASE_URL=
WEB_ORIGIN=http://localhost:3000
# Requests per IP per minute on endpoints that trigger LLM work
RATE_LIMIT_PER_MINUTE=10
# Extracted fields below this confidence are flagged for human review
REVIEW_CONFIDENCE_THRESHOLD=0.7
