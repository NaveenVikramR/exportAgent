# Copy to .env on the server (cp .env.example .env) and fill in. Never commit .env.

# Your Elastic IP with dashes, plus .sslip.io. Example for 13.201.45.67:
SITE_ADDRESS=13-201-45-67.sslip.io

# Paste your keys after the = sign, no quotes, no spaces.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Image version to run. latest = newest build of main. A commit SHA pins a version.
IMAGE_TAG=latest
